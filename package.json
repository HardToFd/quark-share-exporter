{
  "name": "quark-share-exporter",
  "version": "0.1.0",
  "description": "基于夸克网盘官方 Skill 的跨平台批量上传、分享链生成与 CSV/Excel 导出工具",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Codex",
  "license": "UNLICENSED",
  "scripts": {
    "assets": "node scripts/generate-icon.mjs",
    "dev": "npm run assets && electron-vite dev",
    "build": "npm run assets && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --universal --publish never"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "build": {
    "appId": "com.local.quarkshareexporter",
    "productName": "夸克分享链批量导出",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/quark-drive",
        "to": "quark-drive",
        "filter": [
          "**/*"
        ]
      }
    ],
    "artifactName": "QuarkShareExporter-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "QuarkShareExporter-${version}-Setup-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "QuarkShareExporter-${version}-Portable-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    }
  }
}
